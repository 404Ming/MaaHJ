{
    "Flag_BattleSkipTurn": {
        // 本文件只放「全局任务配置」的开关载体节点，不再是可执行任务：
        // 这些选项由 interface.json 的 global_option 在客户端的全局任务配置区渲染，
        // 并作为 pipeline_override 作用于所有任务（无论选了哪个资源包/控制器）。
        // 全局任务配置「战斗设置 · 跳过回合」的开关载体，由 switch 选项覆写 enabled。
        "enabled": true,
        "action": {
            "type": "DoNothing"
        }
    },
    "Flag_ClaimHardChest": {
        // 全局任务配置「胜利结算 · 领取高难限定宝箱」的开关载体（switch 选项覆写 enabled）。
        // ⚠️ 默认 true，与 interface.json 的 default_case「Yes」一致（同 Flag_BattleSkipTurn /
        //    DungeonChallenge_Flag_CreateRoom 的约定）；客户端没下发 override 时也应当去领。
        // 实机 2026-10-25：传说副本战斗胜利后，「战斗胜利-战斗贡献结算」页右侧会出现
        // 「高难限定宝箱 / 今日掉落：N/M」+「可领取高难限定宝箱啦！」；点宝箱图标 →
        // 「是否领取高难限定宝箱？」→「确定」领取，今日掉落 N 减 1（3/4 → 2/4）。
        // 关闭时不点宝箱：之后「战斗获得物品结算」点「确认」会弹「还未领取当前副本的
        // 高难限定宝箱，是否退出副本？」，由结算流程点「确定」照常退出（不领取）。
        "enabled": true,
        "action": {
            "type": "DoNothing"
        }
    },
    "Flag_SupportCall": {
        // 全局任务配置「多人支援 · 发送多人支援请求」的开关载体（switch 选项覆写 enabled）。
        // 关闭时不点战斗左下角的「发送多人支援请求」，整段跳过。
        "enabled": false,
        "action": {
            "type": "DoNothing"
        }
    },
    "Flag_SupportScope_All": {
        // 全局任务配置「多人支援 · 支援请求范围」多选框的一个 case。
        // ⚠️ 多选框（checkbox）**只给被选中的 case 下发 override**，未选中时节点保持这里的默认值，
        //    所以四个范围载体的默认值必须是 false，勾选才变 true。
        "enabled": false,
        "action": {
            "type": "DoNothing"
        }
    },
    "Flag_SupportScope_Friend": {
        // 同上：「好友可见」。
        "enabled": false,
        "action": {
            "type": "DoNothing"
        }
    },
    "Flag_SupportScope_Guild": {
        // 同上：「骑士团可见」。
        "enabled": false,
        "action": {
            "type": "DoNothing"
        }
    }
}
