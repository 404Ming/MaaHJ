{
    "Weekly_Start": {
        // 入口：进周常页 → 页内主循环。next 首位挂条件节点，不直接放无条件 DirectHit 节点。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 20000,
        "next": [
            "[JumpBack]Weekly_OpenPage",
            "Weekly_Main"
        ]
    },
    "Weekly_OpenPage": {
        // 主页右侧「每日任务」→ 每日任务页底部「周常」页签。各节点都用 [JumpBack] 回到本节点，
        // 已在该页时对应识别自然落空、由下一节点接上，幂等可重复进入。
        // 兜底两条（用户新增需求）：主页认不到「每日任务」时走「菜单 → 日常」进页，再点「周常」页签。
        // timeout 20000 = 本轮候选的识别预算：现在有 5 个 OCR 候选（每日任务/菜单/日常/周常/主循环），
        // 逐个截图识别需要留足时间，太紧会 reco_timeout → bad next。
        "timeout": 20000,
        "next": [
            "[JumpBack]Weekly_ClickDailyEntry",
            "[JumpBack]Weekly_ClickMenu",
            "[JumpBack]Weekly_ClickDailyFromMenu",
            "[JumpBack]Weekly_ClickWeeklyTab",
            "Weekly_Main"
        ]
    },
    "Weekly_ClickDailyEntry": {
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    380,
                    160,
                    700
                ],
                "expected": [
                    "每日任务"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2500,
        "next": [
            "[JumpBack]Weekly_OpenPage"
        ]
    },
    "Weekly_ClickMenu": {
        // 兜底入口第一跳：主页底部导航最右侧「菜单」（实测 OCR box (636,1228,57,36)）。
        // 只在主页认不到「每日任务」时才走到这里（候选顺序在其后）。
        // max_hit 1：导航一次性，避免监督节点回环重跑。
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    580,
                    1195,
                    140,
                    85
                ],
                "expected": [
                    "菜单"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "timeout": 3000,
        "next": [
            "[JumpBack]Weekly_OpenPage"
        ]
    },
    "Weekly_ClickDailyFromMenu": {
        // 兜底入口第二跳：菜单页功能格里的「日常」（实测 OCR box (195,977,52,32)），
        // 点进去就是每日任务页，下一轮由 Weekly_ClickWeeklyTab 点底部「周常」页签。
        // ⚠️ ROI 只框菜单页那一格（y 930~1015）：每日任务页底部「日常」页签在 (173,1106,59,38)，
        //    框宽了会在页内互点、[JumpBack] 反复命中空转。
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    160,
                    930,
                    140,
                    85
                ],
                "expected": [
                    "日常"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1200,
        "timeout": 3000,
        "next": [
            "[JumpBack]Weekly_OpenPage"
        ]
    },
    "Weekly_ClickWeeklyTab": {
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    250,
                    1080,
                    200,
                    120
                ],
                "expected": [
                    "周常"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2500,
        "next": [
            "[JumpBack]Weekly_OpenPage"
        ]
    },
    "Weekly_Main": {
        // 页内主循环：①先领完可领奖励 ②奖杯≥100 则收尾 ③否则派发未完成任务（子流程结束后回主页、由 Weekly_Dispatch 的 next 重新进周常页）。
        // next 首位挂公共异常处理；Weekly_Finish 作为兜底收尾（Weekly_Dispatch 自禁用后落在这里）。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "[JumpBack]Exception_Start",
            "[JumpBack]Weekly_ClaimRewards",
            "Weekly_TrophyEnough",
            "Weekly_Dispatch",
            "Weekly_Finish"
        ]
    },
    "Weekly_ClaimRewards": {
        "max_hit": 12,
        // 领取任务奖励：只点右侧操作列的「领取」（不碰「前往」），order_by+index 取最上面一条。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    460,
                    470,
                    260,
                    620
                ],
                "expected": [
                    "领取"
                ],
                "order_by": "Vertical",
                "index": 0
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000
    },
    "Weekly_TrophyEnough": {
        // 奖杯判定：左上角奖杯数 ≥ 100 时命中（与每日任务同位置，用正则表达「大于等于100」）。
        // 命中即收尾返回主页；未命中继续派发任务。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    400,
                    90,
                    55
                ],
                "expected": [
                    "[1-9]\\d\\d|\\d{4,}"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": [
            "Weekly_Finish"
        ]
    },
    "Weekly_Dispatch": {
        // 派发未完成任务：WeeklyDispatch 自定义动作扫描列表里带「前往」的已知任务，
        // 回到主页后按其类型调用玩法挑战（风/火/水/土→对应元素试炼、体力→史莱姆宝库）或祈愿（抽卡）子流程。
        // 子流程结束于主页，本节点 next=Weekly_OpenPage 重新进周常页循环。
        // 没有已知可完成任务时，动作内会自禁用本节点避免死循环，届时回到 Weekly_Main 后落到 Weekly_Finish。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "WeeklyDispatch",
                "custom_action_param": {
                    "pool": "友情祈愿"
                }
            }
        },
        "timeout": 3600000,
        "next": [
            "Weekly_OpenPage"
        ]
    },
    "Weekly_Finish": {
        // 收尾：先回主页，再显式 StopTask。
        // 不能只靠 Weekly_Start 的 [JumpBack]Weekly_OpenPage 自然退栈：
        // 主页恢复后 Weekly_OpenPage 会再次命中，把 Weekly_Main → Weekly_Finish 重新拉起，形成死循环。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ReturnHome"
            }
        },
        "timeout": 60000,
        "next": [
            "Weekly_Stop"
        ],
        "on_error": [
            "Weekly_Stop"
        ]
    },
    "Weekly_Stop": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopTask"
        }
    },
    "Weekly_ReturnHome": {
        // 派发前回主页，供 WeeklyDispatch 以 run_task 调用；这里不能挂 StopTask，否则会提前结束整个周常任务。
        // 用 ReturnHome CustomAction 包一次 BackToMainHub_Start：
        // 不能在 Pipeline 里写 [JumpBack]Weekly_Back + BackToMainHub_Start，
        // 主页上 BackToMainHub_Start 永远命中，父节点会反复重入形成「回主页 → 再回主页」死循环。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ReturnHome"
            }
        },
        "timeout": 60000
    }
}
