{
    "Wish_Start": {
        // 祈愿（抽卡）子流程入口：主页→菜单→祈愿→选池→十连→回主页。
        // 由周常任务 WeeklyDispatch 以 run_task 方式调用，pool 通过 pipeline_override 指定（冒险祈愿/友情祈愿）。
        // 导航与选池用 [JumpBack] 循环，回主页统一以前向 BackToMainHub_Start 收口，保证任务能正常结束。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 20000,
        "next": [
            "[JumpBack]Exception_Start",
            "[JumpBack]Wish_OpenMenu",
            "[JumpBack]Wish_OpenPrayer",
            "Wish_Page"
        ]
    },
    "Wish_OpenMenu": {
        "max_hit": 1,
        // 主页右下角「菜单」按钮（底部导航最右侧）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    1180,
                    160,
                    100
                ],
                "expected": [
                    "菜单"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2500,
        "timeout": 2500,
        "next": [
            "[JumpBack]Wish_Start"
        ]
    },
    "Wish_OpenPrayer": {
        "max_hit": 1,
        // 菜单页里的「祈愿」入口（左上区域，避开顶部「菜单MENU」标题）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    20,
                    800,
                    140,
                    140
                ],
                "expected": [
                    "祈愿"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 3000,
        "timeout": 2500,
        "next": [
            "[JumpBack]Wish_Start"
        ]
    },
    "Wish_Page": {
        "next": [
            "[JumpBack]Exception_Start",
            "[JumpBack]Wish_FindPool",
            "Wish_Draw",
            "Wish_Done"
        ]
    },
    "Wish_FindPool": {
        // 在祈愿页内：用顶部「祈愿」标题做锚点（仅祈愿页命中，回主页后必然落空→自然退出循环）。
        // 命中后于底部泳道找目标池（expected 由调用方 override 指定）；找不到则右滑一屏再找，最多 5 次。
        // 兜底：泳道滑动耗尽仍未找到目标池，则直接对当前选中池抽卡（周常「抽卡10次」只要抽到即算完成）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    200,
                    60
                ],
                "expected": [
                    "祈愿"
                ]
            }
        },
        "next": [
            "Wish_SelectPool",
            "Wish_SwipePool",
            "Wish_Draw"
        ]
    },
    "Wish_SelectPool": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    1060,
                    720,
                    170
                ],
                "expected": [
                    "友情祈愿"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "timeout": 2000,
        "next": [
            "Wish_Draw"
        ]
    },
    "Wish_SwipePool": {
        "max_hit": 5,
        // 泳道从右往左滑，露出右侧的祈愿池（如友情祈愿）。
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    650,
                    1135
                ],
                "end": [
                    50,
                    1135
                ],
                "duration": 500
            }
        },
        "post_delay": 1500,
        "timeout": 2000,
        "next": [
            "[JumpBack]Wish_FindPool"
        ]
    },
    "Wish_Draw": {
        // 十连抽奖按钮（底部中间偏右）。点击后等待抽卡动画。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    400,
                    900,
                    320,
                    120
                ],
                "expected": [
                    "十连抽奖"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 6000,
        "timeout": 2000,
        "next": [
            "BackToMainHub_Start"
        ]
    },
    "Wish_Done": {
        // 收口：回到主页并结束子流程。
        "next": [
            "BackToMainHub_Start"
        ]
    }
}
