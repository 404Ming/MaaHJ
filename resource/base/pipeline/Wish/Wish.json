{
    "Wish_Start": {
        // 祈愿（抽卡）子流程入口：主页→菜单→祈愿→确认目标池→十连→收结果→回主页。
        // 由周常任务 WeeklyDispatch 以 run_task 方式调用，pool 通过 Wish_VerifyPool / Wish_SelectPool 的 pipeline_override 指定。
        // 关键约束：只有「横幅确认命中目标池」才会抽卡，选池失败时宁可任务失败也不抽错池。
        // 循环一律用普通 next 回跳（不用 [JumpBack]）：[JumpBack] 会在整条链收尾后重新弹回旧节点，
        // 导致已经回主页的任务又跑回抽卡分支（实测过一次）。
        "action": {
            "type": "DoNothing"
        },
        // 时限覆盖「进页 + 泳道左右扫描 + 确认池 + 十连翻牌」整条链；泳道扫描每步含 2 次 OCR，
        // 旧值 20s 会在还没扫到目标池时就被判超时，表现为「不会选中对应祈愿池」。
        "timeout": 120000,
        "next": [
            "[JumpBack]Exception_Start",
            "Wish_OpenMenu",
            "Wish_OpenPrayer",
            "Wish_Page"
        ]
    },
    "Wish_OpenMenu": {
        "max_hit": 1,
        // 主页右下角「菜单」按钮（底部导航最右侧）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    1180,
                    160,
                    100
                ],
                "expected": [
                    "菜单"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2500,
        "next": [
            "Wish_Start"
        ]
    },
    "Wish_OpenPrayer": {
        "max_hit": 1,
        // 菜单页左下区域的「祈愿」入口（实测位于 x57,y837；避开顶部「菜单MENU」标题与其它按钮）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    20,
                    780,
                    120,
                    120
                ],
                "expected": [
                    "祈愿"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2500,
        "next": [
            "Wish_Start"
        ]
    },
    "Wish_Page": {
        // 祈愿页锚点：左上角「祈愿」标题。没有识别条件的节点在 MaaFramework 里等同 DirectHit，
        // 会让整个子流程「假装成功」，所以这里必须有真实识别条件，导航失败时任务要显式失败。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    200,
                    80
                ],
                "expected": [
                    "祈愿"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "Wish_VerifyPool",
            "Wish_SelectPool",
            "Wish_SwipeLaneBack",
            "Wish_SwipeLane"
        ]
    },
    "Wish_VerifyPool": {
        // 横幅确认：当前展示的祈愿池标题。命中才允许抽卡。
        // 美术字标题 OCR 实测会丢字/串字/繁简混用：
        //   「友情祈愿」→ 友倩祈愿 / 友宿祈愿 / 友祈愿(丢字)
        //   「冒险祈愿」→ 冒險祈願(繁体)
        // 所以 expected 统一用「首字 + 0~3 个任意字符 + 末字(含繁简)」，
        // 首字就是各池的唯一区分点，不能放松。调用方 override 见 weekly_dispatch.pool_pattern()。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    430,
                    720,
                    360
                ],
                "expected": [
                    "友.{0,3}[愿願]"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "Wish_Draw"
        ]
    },
    "Wish_SelectPool": {
        // 底部泳道里直接点选目标池；expected 由调用方 override（默认同 Wish_VerifyPool）。
        // 泳道卡片名字是可读的（720x1280 实测 OCR：「友倩祈愿」0.90、「冒险祈愿」0.92~0.97），
        // 卡片名 box 实测落在 y=1101..1172，旧 ROI(1020..1170) 会把名字下沿切掉，故改为 1040..1200。
        // 目标池不在可视区时这里正常落空，由 Wish_SwipeLane 先把泳道拖出来。
        // max_hit 给 3：泳道已滚到目标卡但点击没生效时还能再点一次，同时不会无限循环。
        "max_hit": 3,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    1040,
                    720,
                    160
                ],
                "expected": [
                    "友.{0,3}[愿願]"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        // 点卡后横幅有一段切换动画，等它稳定再回 Wish_Page 复核，避免「点了但读到的还是旧标题」。
        "post_delay": 800,
        "timeout": 2000,
        "next": [
            "Wish_Page"
        ]
    },
    "Wish_SwipeLaneBack": {
        // 泳道回扫（先把泳道拖到最左端）。泳道的滚动位置会跨次进入保留，
        // 所以只往一个方向拖可能永远扫不到目标池，先回左端再单向向右扫。
        // 实测（720x1280）：卡片位于 y≈1060..1180，卡片名文字 y≈1100..1172；
        // 在 y=1120 上横向拖动只滚动泳道、**不会选中任何池**（横幅标题保持不变）。
        // 步长 300px < 卡片宽度，保证不会整张卡片被跳过。
        "max_hit": 3,
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    140,
                    1120
                ],
                "end": [
                    440,
                    1120
                ],
                "duration": 400
            }
        },
        "post_delay": 1200,
        "timeout": 3000,
        "next": [
            "Wish_Page"
        ]
    },
    "Wish_SwipeLane": {
        // 向右扫描泳道：目标池可能在右侧不可见区（实测「友情祈愿」就在最右边）。
        // 每拖一步都回 Wish_Page 重新识别「横幅 + 泳道卡片」，找到就点、点到就复核；
        // 旧版「盲点泳道最左卡片」的做法会点到火水属性祈愿，等于选错池。
        // post_delay 必须够长：泳道是带惯性的吸附列表，拖完 500ms 内卡片还在滑行，
        // 此时识别会漏掉刚滑进可视区的卡片（实测连续 6 次拖拽全部识别落空）。
        // 宁可扫不完整让子流程失败（WeeklyDispatch 会记错误日志），也不盲点、不抽错池。
        "max_hit": 6,
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    620,
                    1120
                ],
                "end": [
                    320,
                    1120
                ],
                "duration": 400
            }
        },
        "post_delay": 1200,
        "timeout": 3000,
        "next": [
            "Wish_Page"
        ]
    },
    "Wish_Draw": {
        // 十连抽奖按钮（底部右侧，实测 475,967,108,34）。点击后只等 500ms，
        // 抽卡动画由后续 Wish_AfterDraw / Wish_TapReveal 的循环重试兜住（不再依赖 6s 固定等待）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    400,
                    900,
                    320,
                    120
                ],
                "expected": [
                    "十连抽奖"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 3000,
        "next": [
            "Wish_AfterDraw"
        ]
    },
    "Wish_AfterDraw": {
        // 结果页分流：先看是否已到「确认」结算页，否则点屏幕推进翻牌/结果网格。
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "Wish_ConfirmResult",
            "Wish_TapReveal"
        ]
    },
    "Wish_ConfirmResult": {
        // 结算页右下「确认」（实测 472,1179,58,35）——点它回祈愿页。
        // 误点左侧「再抽十次」会再花 1500 友情点，故 ROI 只覆盖右半。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    330,
                    1120,
                    390,
                    160
                ],
                "expected": [
                    "确认"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000,
        "next": [
            "Wish_Done"
        ]
    },
    "Wish_TapReveal": {
        // 翻牌推进：抽卡结果先展示单张卡（「点击空白区域继续」），点 (360,900) 空闲区推进。
        // 该点落在结果网格卡片下方空白处，不会碰到「再抽十次 / 确认」按钮。
        "max_hit": 14,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    352,
                    892,
                    16,
                    16
                ]
            }
        },
        "post_delay": 500,
        "timeout": 1500,
        "next": [
            "Wish_AfterDraw"
        ]
    },
    "Wish_Done": {
        // 收口：回到主页并结束子流程。
        "next": [
            "BackToMainHub_Start"
        ]
    }
}
