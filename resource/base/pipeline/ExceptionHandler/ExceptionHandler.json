    "Exception_Back": {
        // 退一级：图片匹配左下角「返回」图标按钮（Daily/BackButton.png），命中后点其中心（居中点击返回）。
        // 不再写死坐标：实测该模板在带返回图标的页面得分 0.99+，主页仅 0.25，阈值 0.8 区分度充足，
        // 换分辨率/机型也不会点错。max_hit 限制退层级数：5 次还退不回主页，
        // 后面的 Exception_Restart 会接管（兜底重启），不会无限点。
        "max_hit": 5,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    1180,
                    200,
                    100
                ],
                "template": [
                    "Daily/BackButton.png",
                    "Daily/BackButton2.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 3000
    },
    "Exception_BackOneLevel": {
        // 「当前页认不出来 / 监督节点超时」时的**轻量**兜底：识别左下角返回图标按钮
        // （Daily/BackButton.png），命中就点它退一级，链到此结束、把控制权交回调用方重新判定。
        // 认不到图标就不点（本节点无 next），由调用方的下一条候选接管。
        //
        // 与 Exception_Back 用的是同一张模板和同一个 ROI，但**刻意分成两个节点**，语义不同：
        //   Exception_Back        是「回主页链」里的一步（Exception_BackToHub 的候选），目标是把角色送回主页；
        //   Exception_BackOneLevel 只退**一级**，不强迫回主页，更不会像 Exception_BackToHub 那样在
        //                         退不回主页时落到 Exception_Restart（停应用 + 重新拉起，把游戏整个重启）。
        // 这也是项目里已经反复出现的偏好：AncientTower / Shop / Mail / Knights / GameplayChallenge
        // 都宁可直接挂 [JumpBack]Exception_Back 也不挂 Exception_BackToHub，理由同上。
        //
        // ⚠️ 绝不要把它加进 Exception_Start 的 any_of：返回图标在**正常子页面上到处都有**，
        //    一旦进 Or，正常流程每轮都会被它命中并点返回，直接把流程退飞。
        //    它只允许出现在「异常/超时」路径的 next 里（目前唯一调用方是 Exception_Unknown）。
        // max_hit 10：它在整轮任务范围内会被反复调用（不同于 Exception_Back 的一次退层循环），
        //            留得比 5 宽松；用满后交回 Exception_BackToHub 的重路径，避免在
        //            "返回图标点不动"的弹窗上无限点。
        "max_hit": 10,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    1180,
                    200,
                    100
                ],
                "template": [
                    "Daily/BackButton.png",
                    "Daily/BackButton2.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 3000
    },
    "Exception_Restart": {
        // 兜底（回主页失败 / 重试耗尽）：关闭游戏进程 → 重新执行启动游戏工作流 → 停在主界面，
        // 然后把控制权交回调用方（此时在主界面，调用方能从主页重新进入自己的流程）。
        // 复用 LaunchGame 的现有链路：StopApp → LaunchGame_Launch（登录 / 热更新异常 / StartApp）
        // → LaunchGame_AtMainHub → LaunchGame_Done（无 next，子链到此结束）。
        //
        // ⚠️ 这里**绝对不能**写成 "[JumpBack]LaunchGame_StopApp"（原写法，已修）：
        //    [JumpBack] 的语义是"子链跑完后弹栈、回到本节点重新评估 next 列表"——
        //    子链以 LaunchGame_Done 结束（其时游戏**刚回到主页**）→ 弹栈 → 本节点 next 只有
        //    一条且 LaunchGame_StopApp 是无条件命中的 → 立刻又杀进程 → 再启动 → 再到主页 →
        //    再弹栈…… 实测日志（dist/package-mfaa/debug/maafw.log 2026-10-30）：
        //      09:05:11 push jumpback_stack: Exception_Restart
        //      09:06:21 LaunchGame_AtMainHub hit → 09:06:21 LaunchGame_Done
        //      09:06:22 pop  jumpback_stack: Exception_Restart
        //      09:06:22 LaunchGame_StopApp hit      ← 刚回主页又被杀
        //      09:06:27 push jumpback_stack: Exception_Restart  ← 又一轮
        //    用户看到的「异常重启后回到主页，依旧不停重启、永远回不到任务」就是这条死循环。
        //    判据：next 里唯一的 [JumpBack] 目标若是**无条件命中**的节点（没有 recognition），
        //    弹栈后的重评估必然再次命中它 —— 这类组合一律不能出现在 [JumpBack] 位置。
        //    同理见 GameplayChallenge_UnknownFallback 注释里的 Exception_AtHub 案例。
        //
        // max_hit 3：冷重启一次约 60s，给 3 次机会足够覆盖偶发的登录/更新抖动；
        // 用尽后本节点不再命中，控制权沿调用方 next 链继续回退，由循环控制器按既有次数上限收尾，
        // 不会再出现"一直重启个不停"。
        // ⚠️ max_hit 计数是跨 run_task 累加的（本任务的 ResetCount 不会清它），所以这是**整轮运行**的
        //    总预算，不要调得太大，否则一次卡死会把后面所有任务的恢复额度都用光。
        "max_hit": 3,
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "LaunchGame_StopApp"
        ]
    },
    "Exception_CloseIcon": {
        // 「弹窗 / 浮层挡屏」兜底：识别页面上的「X」关闭图标（模板 Exception/CloseButton.png），
        // 命中就点它中心把弹窗/浮层关掉，链到此结束、把控制权交回调用方重新判定。
        // 认不到就不点（本节点无 next），由调用方的下一条候选接管（通常是 Exception_BackOneLevel）。
        //
        // 模板来自真机截图裁剪（道具详情弹窗，实测 box=(600,420,37,30) score=1.000）。
        // 不限定 roi：X 会随弹窗位置变化（本例弹窗偏上，X 在 y≈420），固定 ROI 框不住所有弹窗，
        // 因此按**全屏**匹配；threshold 0.85 用于抑制误命中。
        //
        // ⚠️ 模板资产必须来自**真色**来源（adb 原始截图 / MaaFramework 自己写的 on_error 截图）：
        //    harness 的 t.save_png 会把 BGR 当 RGB 写，存出来的 PNG 文件是 R/B 互换的，
        //    拿它裁模板会得到颜色不对的资产（曾实测退化成 0.512 的垃圾匹配）。
        //    运行时数组本身可信：实测与 adb 原始截图逐像素平均差 0.00。
        // ⚠️ 绝不要把它加进 Exception_Start 的 any_of：X 图标在正常页面上也会出现，
        //    一进 Or，正常流程每轮都会被它命中并点掉正常界面。
        //    它只允许出现在「异常/超时」路径的 next 里（目前唯一调用方是 Exception_Unknown）。
        // max_hit 10：整轮任务范围内最多关 10 个浮层（与 Exception_BackOneLevel 同量级）；
        //            用满后交回后面的候选（退一级 → 回主页 → 重启），不会无限点。
        "max_hit": 10,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Exception/CloseButton.png",
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 3000
    },
    "Exception_AwayFull": {
        // 「暂离已满」弹窗（用户新增需求）：点「创建房间」/「开始挑战」之后，如果自动挂机的
        // 暂离位已满，本次挑战**不会真正开始**，而是弹这个框。
        // 实测（流程截图/公共功能/异常处理/暂离已满/1暂离已满.png）：
        //   标题「暂离已满」(289,378,141,43)；
        //   正文「暂离副本数量已达上限，请先完成正在战斗中的副本。」；
        //   按钮「取消」(166,822,68,42)、「前往战斗列表」(426,826,176,38)。
        // 只认标题：正文会换行、OCR 常拆成两段；标题是这层弹窗独有的。
        // 处理链（用户给的 5 张截图）：前往战斗列表 → 点「待确认」→ 逐条「待领取报酬」
        //   → 结算页「撤退 / 确认」→ 交回主页链收尾。
        // 调用方式：`[JumpBack]Exception_AwayFull`（条件节点，没弹窗时不命中，不打断原流程）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    240,
                    340,
                    240,
                    120
                ],
                "expected": [
                    "暂离已满"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        // timeout 只给 600ms：这个节点被挂在「点创建房间 / 开始挑战」之后当 [JumpBack] 候选，
        // 每点一次都会先过一次识别。给 3000 会让每次点击都白等 3 秒；弹窗在点击后
        // post_delay(500ms) 内就已经画出来了，600ms 足够。
        "timeout": 600,
        "next": [
            "Exception_AwayFullGotoList"
        ]
    },
    "Exception_AwayFullGotoList": {
        // 弹窗右下「前往战斗列表」（实测 box (426,826,176,38)）。左侧「取消」在 x 166~234，框外。
        "max_hit": 2,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    400,
                    780,
                    230,
                    110
                ],
                "expected": [
                    "前往战斗列表"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1200,
        "timeout": 3000,
        "next": [
            "Exception_AwayFullPending"
        ]
    },
    "Exception_AwayFullPending": {
        // 战斗列表页那条战斗的「待确认」（实测 box (561,1129,108,43)）。
        // ROI 只框右下这一条：待确认**页**的标题也叫「待确认」，但它在 (304,173)，不在框内。
        "max_hit": 2,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    500,
                    1080,
                    200,
                    140
                ],
                "expected": [
                    "待确认"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1200,
        "timeout": 3000,
        "next": [
            "Exception_AwayFullClaim"
        ]
    },
    "Exception_AwayFullClaim": {
        // 「待确认」页逐条领「待领取报酬」（实测 4 条：y≈422/584/742/908，x≈517~640）。
        // 每条点完会进结算页（作战失败 / 战斗胜利），由 Exception_AwayFullResult 收尾后再回来领下一条。
        // max_hit 6：一次最多结算 6 条，用尽后落到 Exception_AwayFullBack 回主页，不会无限点。
        "max_hit": 8,
        "recognition": {
            "type": "OCR",
            "param": {
                // ROI 下界从 940 放到 1010：实机 2026-10-28 待确认页滚过之后第 4 条
                // 「待领取报酬」落在 y≈942（box (520,942,121,32)），旧下界刚好把它切掉 → 漏领。
                "roi": [
                    440,
                    370,
                    270,
                    640
                ],
                "expected": [
                    "待领取报酬"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "timeout": 3000,
        // ⚠️ 这里**不能**直接挂无条件的 Exception_AwayFullBack：
        //    点完「待领取报酬」后结算页要加载（实测 2~3s，慢的时候更久），
        //    一次 3s 识别不到「撤退/确认」就会直接放弃剩下的报酬回主页。
        //    改成「先认结算页，认不到就进 Settle 等 2s 再重判待领取报酬」。
        "next": [
            "Exception_AwayFullResult",
            "Exception_AwayFullSettle"
        ]
    },
    "Exception_AwayFullResult": {
        // 结算页收尾：失败页是「撤退」(337,1202,61,31)、胜利页是「确认」(332,1192,57,32)，
        // 「点击空白处继续」(273,1196,146,26) 是多屏结算的翻页键，三者都在底部同一条带上
        // （ROI 250,1150,300,110 同时兜住）。
        // timeout 6000：结算页有加载动画，3s 经常还没画出按钮就被判"没有"。
        "max_hit": 8,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    250,
                    1150,
                    300,
                    110
                ],
                "expected": [
                    "撤退|确认|点击空白处继续"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        // 胜利结算有入场动画（「战斗胜利」大字 + 贡献奖励飞入），1.5s 常常点完还没关闭，
        // 留 2.5s 再交给 Settle 判定。
        "post_delay": 2500,
        "timeout": 6000,
        "next": [
            "Exception_AwayFullSettle"
        ]
    },
    "Exception_AwayFullSettle": {
        // 结算页点完之后的中转：等 2s 让画面回到「待确认」页，再判还有没有下一条报酬。
        // 有 → 回 Claim 继续领；没有 → 交回主页链收尾。
        // 为什么不让 Claim 直接当 next：Claim 点完立刻就判，画面还在结算页，必然认不到，
        // 会误判成"已经领完"提前退出（2026-10-28 实机就是这个问题）。
        "pre_delay": 2000,
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        // 三个候选，按「当前画面最可能是什么」排序：
        //   1) 还在结算页（上次确认没点掉 / 又多翻了一屏）→ 再点一次确认；
        //   2) 已回到待确认页且还有报酬 → 领下一条；
        //   3) 都没有 → 回主页。
        // 没有第 1 条时，胜利页动画期间会误判成"已领完"直接退出（用户反馈的现场）。
        "next": [
            "Exception_AwayFullResult",
            "Exception_AwayFullClaim",
            "Exception_AwayFullBack"
        ]
    },
    "Exception_AwayFullBack": {
        // 待领取报酬已经领完（Settle 重判后仍认不到）→ 交回主页链收尾：
        // 待确认页 / 战斗列表页都有返回图标，BackToMainHub 会逐级退回主页。
        // 无条件节点，必须放在 Exception_AwayFullSettle 的 next 末位。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "BackToMainHub_Start"
        ]
    },
    "Exception_Unknown": {
        // 「卡死 / 未知画面」入口：不靠画面特征识别，而是由调用方用 timeout + on_error 触发——
        // 监督节点在 timeout 内既没匹配到任何正常候选（卡死 / 当前页认不出来），on_error 就落到这里。
        // 处理顺序 =「好友申请 → 关浮层 → 退一级 → 最后回主页」，越来越重：
        //   Exception_FriendRequest 结算后的「好友申请」框 → 点「取消」（**最轻**：已知弹窗、有界）；
        //   Exception_CloseIcon    页面上有「X」关闭图标 → 点掉它关掉弹窗/浮层
        //                          （不动页面层级，多半只是有残留浮层挡着）；
        //   Exception_BackOneLevel 认到左下角返回图标 → 退**一级**（误入子页时用）；
        //   Exception_BackToHub    上面都认不到（满屏错误页、加载页）→ 才走重路径：
        //                          尽力回主页，回不去（Exception_Back 用满）才 Exception_Restart 重启。
        // ⚠️ 顺序不能反：Exception_BackToHub 是"无条件 DoNothing + next"，一旦排在前面，
        //    后面的候选永远不会被走到。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "Exception_AwayFull",
            "Exception_FriendRequest",
            "Exception_CloseIcon",
            "Exception_BackOneLevel",
            "Exception_BackToHub"
        ]
    }
}
