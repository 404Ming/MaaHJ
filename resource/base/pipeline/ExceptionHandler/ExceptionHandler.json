                    "点击空白区域关闭"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    330,
                    1185,
                    80,
                    60
                ]
            }
        },
        "post_delay": 500,
        "timeout": 3000
    },
