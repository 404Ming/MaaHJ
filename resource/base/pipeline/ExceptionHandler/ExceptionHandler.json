        // 门控与 StaminaRefill_Dialog / GameplayChallenge_SettleRefillGate 完全一致（放宽 ROI + threshold 0.2）。
        // 状态机走完（Back 关掉弹窗）后由 [JumpBack] 接回本列表，本节点的链随即结束、交回调用方。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    180,
                    120,
                    380,
                    100
                ],
                "expected": [
                    "补充体力"
                ],
                "threshold": 0.2
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "[JumpBack]StaminaRefill_Dialog"
        ]
    },
    "Exception_RewardClose": {
        // 「恭喜获得」这类遮屏奖励提示：文案「点击空白区域关闭」实测在 ROI [250,925,220,60]
        // （StaminaRefill_RewardClose / Daily_CloseRewardPopup 同款，OCR 命中 1.000）。
        // 空白位置固定，故用行文本做门控后点固定点；max_hit 限制同一次运行里的关闭次数。
        // 关掉后不写 next：让调用方下一轮自己重新判定（调用方的监督节点会反复回到这里）。
        "max_hit": 3,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    250,
                    925,
