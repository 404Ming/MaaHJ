{
    // 「自动挂机」任务：主页右下「战斗列表」→「自动挂机」→ 按任务设置勾选副本难度 →「确定」。
    // 全部交互都在 Python（AutoIdleRun）里，实机 720x1280 逐跳印证：
    //   主页「战斗列表」→ 战斗列表页「自动挂机」→「选择要挂机的副本」弹窗
    //   →「重置」清空历史勾选 → 按系列展开、点开副本卡片读标题、勾难度 →「确定」
    //   → 外层「确定」→ 战斗画面出现「自动挂机中」= 启动成功，否则重走一遍（最多 3 次）。
    // ⚠️ 会真实开始挂机（连续自动战斗、消耗 BP）。一个难度都没勾选时整段跳过。
    // timeout：挂机是长流程（含多次战斗/加载），给足 1 小时后由客户端停止兜底。
    "AutoIdle_Start": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoIdleRun",
                "custom_action_param": {}
            }
        },
        "timeout": 3600000,
        "next": [
            "AutoIdle_Done"
        ]
    },
    "AutoIdle_Done": {
        // 终态：启动自动挂机后立刻收尾（挂机本身由游戏自己跑，不需要本任务继续陪着）。
        // 无条件节点，保证任务以成功收尾。
        "action": {
            "type": "DoNothing"
        }
    },
    // ---- 任务设置载体节点（纯数据，不被任何 next 引用、永不执行）----------------------
    // ⚠️ 必须全部**预定义**：pipeline_override 只做属性合并、不会创建节点，
    //    少了它们客户端的勾选会静默失效（get_node_data 拿到 None）。
    // 一个 (副本 × 难度) 一个节点：checkbox 的每个 case 只能覆写不同节点的 enabled。
    // 王国灾厄
    "AutoIdle_S1_01_Normal": {
        // 野猪统领 · 普通
        "enabled": false,
        "action": {
            "type": "DoNothing"
        }
