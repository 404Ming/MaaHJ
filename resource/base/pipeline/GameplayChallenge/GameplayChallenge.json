    "GameplayChallenge_BattleEnter": {
        // 战斗模块入口：每场战斗开始时登记一次（编队页「开始战斗」之后，或结算页「挑战下一关」之后）。
        // BattleModuleRecord 负责：在有界时间内**确认战斗画面已在场**再累计已开始的战斗次数、
        // 复位战斗内带 max_hit 节点的命中计数、按剩余次数启停结算页「挑战下一关」。
        // times 由循环控制器注入。战斗过程中不再读取/打印「战斗设置」与回合数。
        //
        // ⚠️ 本节点必须保持 DirectHit（无 recognition）：
        // 它挂在 FormationStart / ResultNextStage 的 next 上，而 next 链一旦失败会**把整个
        // BattleLoop 监督链判死** —— 实测给它加 OCR 门控后，"战斗还没开出来"的那一瞬识别失败，
        // 整轮 run_task 立即结束，结算页再无人处理，游戏自己又开一局又没人登记，最后任务失败。
        // 因此"战斗是否在场"的判定放在 BattleModuleRecord 里做有界等待（默认 5s），
        // 锚点识别单独放在下面的 GameplayChallenge_BattlePresence 节点，只给 Python 调用。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BattleModuleRecord",
                "custom_action_param": {
                    "times": 1
                }
            }
        },
        "timeout": 5000,
        "next": [
            "GameplayChallenge_BattleLoop"
        ]
    },
    "GameplayChallenge_BattleEnterQuick": {
        // 「结算过渡屏」之后专用的登记入口（ResultTeamContinue 的 next）：**只看一眼、不等**（wait=0.3）。
        //
        // ⚠️ 这里绝不能等：过渡屏点掉之后露出来的多半是**结算页**（「挑战下一关」/「确认」），
        //    而结算页带着「2S后自动再次挑战」倒计时，必须马上把控制权还给 BattleLoop 去点按钮。
        //    实机事故（这里用默认 wait=10s 时）：BattleEnter 空等十秒 →
        //      ① 结算页两个按钮**一次都没被点到**（ResultNextStage / ResultConfirm 进入次数均为 0）；
        //      ② 游戏自己的 2S 自动再战白开了 3 局（计划 3 次实际打了 6 次，多扣体力）；
        //      ③ 用户感知就是「战斗胜利页面识别与点击很慢」。
        //    wait=0.3 的语义：若此刻**已经**在战斗中（例如过渡屏发现得太晚、自动再战已经开了）
        //    就正常登记，否则立刻放弃登记、交回 BattleLoop。
        //    真正需要登记的战斗由 FormationStart / ResultNextStage 两条路径上的 BattleEnter 负责
        //    （那两处战斗一定会加载出来，给足 5s 不会漏计）。
        // 本节点不配 times：它只做登记前的在场判定，planned 已由 BattleEnter 设置过。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BattleModuleRecord",
                "custom_action_param": {
                    "wait": 0.3
                }
            }
        },
        "timeout": 5000,
        "next": [
            "GameplayChallenge_BattleLoop"
        ]
    },
    "GameplayChallenge_BattlePresence": {
        // 「战斗画面已在场」的锚点节点：**不被任何 next 引用、永不作为链路节点执行**，
        // 只由 BattleModuleRecord 通过 context.run_recognition() 轮询调用，
        // 用来判定"这一刻是不是真的在打"（决定是否把本次 BattleEnter 记成一场战斗）。
        // 锚点实测：左上「战斗剩余时间 39:5x」与「第N回合」，4 帧战斗屏 box 稳定于
        // x=537~538, y=38~42, w=175~179, score≥0.95；
        // 副本详情页 / 编队页 / 助战选择页 / 主页 / 结算页 均 hit=False
        //（结算过渡屏「点击空白处继续」那一屏也会命中不到 —— 这正是"点击空白处继续 +1 次数"的成因）。
        // expected 是**全串正则**（参见 PickSupport 的 ".*Rank.*"），OCR 文本带时间后缀且
        // 回合数带噪声前缀（实测出现过 ※第1回合 / 義第1回合），所以两个模式都必须带 .* 兜住。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    500,
                    0,
                    220,
                    80
                ],
                "expected": [
                    "战斗剩余时间.*",
                    ".*第.回合.*"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        }
    },
    "GameplayChallenge_BattleLoop": {
        // 战斗模块监督节点：推进回合 → 结算/胜利页处理 → 关弹窗 → 回到副本详情页即收尾。
        // 结算（战斗胜利）页处理按顺序：
        //   ResultNextStage    点「挑战下一关」：本副本支持快速再战且后面还有次数时直接再打一局；
        //   ResultTeamContinue 点「点击空白处继续」：认出「战斗胜利 + 点击空白处继续」那一屏就立刻点，
        //                      不点也要等它自己的 2S 自动切页；无论这一屏是我们点「挑战下一关」带来的，
        //                      还是结算页 4S 倒计时自己又开了一局带来的，都立即点掉继续推进；
        //   ResultConfirm      点「确认」：打满次数 / 没有该按钮时退回副本详情页收尾。
        // 注意结算页有「4S后自动再次挑战」倒计时，路径都要抢在倒计时内点掉，
        // 否则会自己再打一局、白扣一次体力；因此结算阶段用有界的 SettleWait 反复轮询，
        // 各节点 max_hit 是最后一道保险（每次进战斗由 BattleModuleRecord 复位）。
        // 结算自动再战被体力拦住时会弹「补充体力」界面（实测：结算后紧跟补充体力界面），
        // 所以这里也放一道补体力门控，命中先补满体力，再回本监督节点重新判断。
        // ⚠️ 末位 [JumpBack]GameplayChallenge_UnknownFallback 同样不可去：本节点也是 DirectHit，
        //    on_error 永不触发；战斗/结算阶段的候选（含靠 max_hit 续命的 SettleWait）全部用尽后，
        //    必须有一个出口把"认不出来的页面"交给异常链（关 X / 退一级 / 回主页），
        //    否则会 bad next 直接判死。放在最后一位，正常流程永远走不到它。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": [
            "[JumpBack]Exception_AwayFull",
            "GameplayChallenge_SettleRefillGate",
            "[JumpBack]GameplayChallenge_BattleTurn",
            "[JumpBack]GameplayChallenge_ResultNextStage",
            "[JumpBack]GameplayChallenge_ResultTeamContinue",
            "[JumpBack]GameplayChallenge_ResultConfirm",
            "[JumpBack]GameplayChallenge_FriendCancel",
            "GameplayChallenge_OnceDone",
            "[JumpBack]GameplayChallenge_SettleWait",
            "[JumpBack]GameplayChallenge_UnknownFallback"
        ]
    },
    "GameplayChallenge_SettleRefillGate": {
        // 战斗/结算阶段的补体力门控：命中说明结算自动再战（或其它扣体力动作）被体力拦住、弹出了「补充体力」界面。
        // 两个入口都会走到它：BattleLoop 的 next 首位，以及 ResultNextStage（点完「挑战下一关」）的 next 首位。
        // 后者是必须的——点「挑战下一关」被体力拦住时，BattleEnter 会白等 5s 战斗在场判定才交回，
        // 把这个门控放前面可以立刻接住弹窗直接进补体力流程。
        // 补满体力后先经 SettleRetryReset 复位结算页命中计数，再回到 BattleLoop 重新判断：
        // 已经回到副本详情页由 OnceDone 收尾；还停在结算页则重新由 ResultNextStage 点「挑战下一关」，
        // 不会卡死、不会白扣一次体力，也不会把没打的第 2 次挑战错收成「确认」。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    180,
                    120,
                    380,
                    100
                ],
                "expected": [
                    "补充体力"
                ],
                "threshold": 0.2
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "[JumpBack]StaminaRefill_Dialog",
            "GameplayChallenge_SettleRetryReset",
            "GameplayChallenge_BattleLoop"
        ]
    },
    "GameplayChallenge_SettleRetryReset": {
        // 补完体力回到结算页后的一次性复位：把结算页各按钮节点的 max_hit 命中计数清零。
        // 为什么必须有：点「挑战下一关」时体力不足会先弹「补充体力」而不是开战，那次点击已经把
        // ResultNextStage 的 max_hit=1 用掉；补完体力回来它就会被跳过 → 落到 ResultConfirm 点「确认」
        // 退回详情页 → 挑战次数打不满（实机 bug：第 2 次挑战永远打不出来）。
        // 只复位结算页这几个节点：战斗内节点（BattleTurn / SettleWait）由 BattleModuleRecord 在
        // 每场战斗开始时统一复位，不要在这里重复处理。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "GameplayChallenge_ResultNextStage",
                        "GameplayChallenge_ResultTeamContinue",
                        "GameplayChallenge_ResultConfirm",
                        "GameplayChallenge_SettleWait"
                    ]
                }
            }
        },
        "timeout": 3000,
        "next": [
            "GameplayChallenge_BattleLoop"
        ]
    },
    "GameplayChallenge_BattleTurn": {
        "max_hit": 80,
        // 战斗中的回合按钮：只点「跳过回合」。
        // ⚠️ 「回合开始」绝对不能点（点它会自己开一回合、把自动流程带偏），
        //    所以 expected 只保留「跳过回合」，不再接受「回合开始」。
        // 点击由 BattleTurnClick 完成（识别框中心即按钮中心），且不再逐回合打印日志。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    260,
                    1075,
                    200,
                    75
                ],
                "expected": [
                    "跳过回合"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BattleTurnClick"
            }
        },
        "post_delay": 500,
        "timeout": 1500
    },
    "GameplayChallenge_SettleWait": {
        "max_hit": 12,
        // 结算/加载动画等待：等待时间有界（12 次），超过后不再等待，避免整条链路无限挂起。
        // ⚠️ max_hit 是跨 run_task 累加的：连续挑战时由 BattleModuleRecord 在每场战斗开始时复位，
        // 否则第二次挑战起本节点会被直接跳过，BattleLoop 的 next 全部落空 → 「bad next」判死整条链路。
        "pre_delay": 1500,
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000
    },
    "GameplayChallenge_ResultNextStage": {
        "max_hit": 1,
        // 战斗结算页左下角「挑战下一关」：实际效果就是再重复挑战一次（同一编队直接进下一场战斗），
        // 连续挑战时用它省掉「副本详情页 → 难度 → 开始挑战 → 助战选择 → 编队 → 开始战斗」整段操作。
        // 由 BattleModuleRecord 按剩余次数启停：打满「挑战次数」后本节点被 enabled=false 跳过，
        // 结算页改由 ResultConfirm 点「确认」退回详情页收尾，不会多打一局、多扣一次体力。
        // max_hit 1：同一场战斗的结算页只点一次，避免点完页面还没切走时重复点击；
        //          命中计数由 BattleModuleRecord 在每场战斗开始时复位。
        //          ⚠️ 点「挑战下一关」时**体力不足会先弹「补充体力」而不是开战**，这次点击已经把
        //          max_hit 用掉；补完体力回到结算页时本节点会被直接跳过 → 落到 ResultConfirm 点「确认」
        //          → 挑战次数打不满（实测 bug）。所以 next 首位挂 SettleRefillGate 先兜掉「补充体力」
        //          （否则要白等 BattleEnter 的 5s 战斗在场判定），并在补体力收尾处用
        //          GameplayChallenge_SettleRetryReset 复位结算页各节点的命中计数。
        // ROI 左侧按钮带（实测 OCR 文本 box (96,1193,129,32) score 1.000；按钮 y 约 1175~1235），
        // 点击目标用识别框中心，即按钮内部。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    60,
                    1165,
                    220,
                    80
                ],
                "expected": [
                    "挑战下一关"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 1200,
        "next": [
            "GameplayChallenge_SettleRefillGate",
            "GameplayChallenge_ResultTeamContinue",
            "GameplayChallenge_BattleEnter"
        ]
    },
    "GameplayChallenge_ResultTeamContinue": {
        "max_hit": 1,
        // 再战过渡页（「战斗胜利」+ 队伍等级/上阵/助阵 + 底部「2S后切换页面 点击空白处继续」）：
        // 整页只是叠在结算页上的编队信息，实测 OCR 文本 box (273,1196,146,26) score 1.000。
        // 认出这一屏立即点掉（点提示文字所在的空白区），不等它自己的 2S 自动切页。
        // 两个入口都会走到它：BattleLoop 直接命中（结算页倒计时自动开的那一局也会经过本屏），
        // 以及 ResultNextStage 点完「挑战下一关」之后的 next。
        // ⚠️ next 必须是 BattleEnterQuick（只看一眼、不等），**不能用 BattleEnter**：
        //    这一屏点掉后露出来的是结算页，占着「2S后自动再次挑战」倒计时，
        //    必须尽快把控制权交回 BattleLoop 去点「挑战下一关」/「确认」；
        //    用会阻塞的 BattleEnter 会造成「两个按钮一次都没点到 + 游戏白开好几局」
        //    （详见 BattleEnterQuick 的注释里记的实机事故）。
        // max_hit 1 + 每场战斗由 BattleModuleRecord 复位：一个再战周期只点一次。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    230,
                    1180,
                    260,
                    60
                ],
                "expected": [
                    "点击空白处继续"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 1200,
        "next": [
            "GameplayChallenge_BattleEnterQuick"
        ]
    },
    "GameplayChallenge_ResultConfirm": {
        "max_hit": 20,
        // 战斗结算界面的「确认」（左侧是「挑战下一关」/「4S后自动再次挑战」倒计时，右侧是「确认」）。
        // 退回副本详情页，是打满次数或副本没有「挑战下一关」时的正常收尾路径（OnceDone 接着判定本轮结束）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    495,
                    1175,
                    130,
                    70
                ],
                "expected": [
                    "确认"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 1200
    },
    "GameplayChallenge_FriendApplyText": {
        // 「好友申请」弹窗正文（实测 box (176,742,366,32)「是否向该名玩家发送好友申请」）。
        // 只做门控，不点击 —— 给 FriendCancel 用 And 组合，避免"看到随便一个『取消』就点"。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    700,
                    520,
                    110
                ],
                "expected": [
                    "发送好友申请"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000
    },
    "GameplayChallenge_FriendCancelButton": {
        // 好友申请弹窗左侧「取消」(实测 box (157,849,70,40))。只做识别，点击在 FriendCancel。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    110,
                    820,
                    160,
                    80
                ],
                "expected": [
                    "取消"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000
    },
    "GameplayChallenge_FriendCancel": {
        "max_hit": 5,
        // 副本结束后可能弹出「好友申请」（助战玩家），选「取消」不做社交操作。
        // ⚠️ 必须是 And：只认「取消」这两个字会误点**别的弹窗**左侧的取消——
        //    实机 2026-10-28 复现：编队页点「开始战斗」后弹「暂离已满」，本节点只凭
        //    (110,820,160,80) 里的「取消」(166,822,68,42) 就直接点掉了，
        //    正确做法是交给 Exception_AwayFull 去点「前往战斗列表」。
        //    加上「是否向该名玩家发送好友申请」门控后，暂离弹窗不会再被本节点吃掉。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GameplayChallenge_FriendApplyText",
                    "GameplayChallenge_FriendCancelButton"
                ],
                // box_index=1：用第二个子节点（「取消」按钮）的框去点中心，
                // 与 StaminaRefill 的「使田/使用」And 用法一致，不写死坐标。
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 1200
    },
    "GameplayChallenge_OnceDone": {
        // 一次挑战的终点：确认已经回到副本详情页（「开始挑战」重新可见），子任务在此结束。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    990,
                    340,
                    160
                ],
                "expected": [
                    "开始挑战"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        }
    },
    "GameplayChallenge_Done": {
        // 收尾：按「挑战次数」跑完后把角色送回主页（惑星之间），不再停在副本详情页 / 列表页上。
        // 判定顺序即返回顺序：
        //   Exception_AtHub      已在主页（认到「惑星之间」）→ 命中即结束，任务成功收尾；
        //   BackToMainHub_Back   有返回图标的层级（终末之地列表页等地）→ 图片匹配 Daily/BackButton.png 退一级；
        //   Exception_Back       纯图标返回按钮的层级（副本详情页等）→ 同样地图片匹配 Daily/BackButton.png 退一级；
        //                        不再写死坐标：模板在带返回图标的页面得分 0.99+，主页仅 0.25，阈值 0.8 足够区分。
        // 每点一次都由 [JumpBack] 回到本节点重新判定，直到认到主页锚点。
        // 末位 GameplayChallenge_Finished 是无条件终点：即使层级没退完也正常收尾。
        // ⚠️ 刻意不接 Exception_BackToHub：那条链在退不回主页时会落到 Exception_Restart（停应用 + 重新拉起），
        //    把游戏整个重启掉，收尾阶段不需要这种兜底。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 8000,
        "next": [
            "Exception_AtHub",
            "[JumpBack]BackToMainHub_Back",
            "[JumpBack]Exception_Back",
            "GameplayChallenge_Finished"
        ]
    },
    "GameplayChallenge_Finished": {
        // 终态：本次玩法挑战结束（已尽力回到主页）。无条件节点，保证任务以成功收尾。
        "action": {
            "type": "DoNothing"
        }
    }
}
