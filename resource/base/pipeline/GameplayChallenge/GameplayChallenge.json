    "GameplayChallenge_StaminaRefillGate": {
        // 体力不足时「开始挑战」会先弹「补充体力」界面（实测：这一步不会走到助战选择）。
        // 命中说明体力不足：交给 StaminaRefill 状态机按全局配置的体力药优先级消耗体力药；
        // 状态机走完（Back 收尾）后由 [JumpBack] 接回本列表，重新点「开始挑战」。
        // 未命中则本节点被跳过，由上层 next 继续走助战选择。
        // 门控与 StaminaRefill_Dialog 一致（放宽 ROI + threshold 0.2），避免标题描边/弹窗动画漏判。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    180,
                    120,
                    380,
                    100
                ],
                "expected": [
                    "补充体力"
                ],
                "threshold": 0.2
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "[JumpBack]StaminaRefill_Dialog",
            "GameplayChallenge_StartChallenge"
        ]
    },
    "GameplayChallenge_PickSupport": {
        // 助战选择自定义逻辑（PickSupport）：
        // 在「助战选择」页按 y 升序挑条目 → 点完**必须**校验已进入编队页（认底部「开始战斗」），
        // 没进入就换下一条（至多 3 条），全失败返回失败（不再有"认不到就盲点默认位置"的兜底）；
        // 再在编队页按**主要成员头像上的元素徽章**判定队伍属性（PickSupport._classify_team_element），
        // 用队伍属性去查全局配置；当前助战的**属性或类型**任一对不上就点「助战」回助战选择页，
        // 就点「助战」回助战选择页，**按颜色认出该属性对应的元素页签**并直接点它、把列表滚回顶部再找
        //（PickSupport._locate_element_tab：与认元素徽章同一套取色判据；写死的坐标映射只作兜底）。
        // 选中态页签的图标被高亮背景压暗、颜色不可靠，改用"它是那个 113px 宽块 + 列表内容确认"定位。
        // ⚠️ 页签行可横向滚动：一屏只放得下 5 个，第 6 个「暗」要横向滑动标签行才露出（用户实测）。
        // 只在这一个页签里找；没有"属性+类型"都对的就退让成"同属性、类型不同"；
        // 全试完仍没有就把页签**恢复成队伍属性**（否则收尾会挑到别的属性的助战）。
        // 循环至多 3 轮 → 找不到则回到编队页按当前助战继续。
        // ⚠️ 队伍属性不能用「已选助战的 buff」里的属性代替：那段文案说的是助战自己的属性，
        // 拿它当队伍属性是闭环，永远纠正不了元素（实测风队配到火助战后再也换不回来）。
        // 期望值来自下面六个 SupportPref 数据节点（不能写在 custom_action_param：见那里的注释）。
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    ".*Rank.*",
                    "助战选择"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PickSupport"
            }
        },
        "timeout": 5000,
        "next": [
            "GameplayChallenge_FormationStart"
        ]
    },
    // ---- 助战偏好数据节点（A1 接线）----
    // 六个属性各一个**纯数据节点**：不被任何 next 引用、永不执行，只作为 interface.json
    // 「X属性编队助战」选项 override 的落点，PickSupport 用 context.get_node_data() 读取。
    // select 类型选项按 PI 规范写 recognition.param.expected，因此节点按 OCR 预定义。
    // ⚠️ 之所以必须"一个属性一个节点"，是因为 PI 客户端把每个选中 case 作为**一条独立的**
    // pipeline_override 下发，而 MaaFramework 对同一字段是**整体替换**而非深合并：
    // 六个属性共写同一节点的同一字段时只有最后一条生效（实测 global_option 里排最后的
    // 「暗属性编队助战」一直覆盖其余五个，火属性助战永远读到 None）。
    // 默认值与 interface.json 的 default_case 一致（神）。
    "GameplayChallenge_SupportPref_Fire": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "神"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        }
    },
    "GameplayChallenge_SupportPref_Water": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "神"
                ]
            }
        },
