{
    "GameplayChallenge_Start": {
        // 入口：按 interface.json「挑战次数」打到目标次数，循环体是 GameplayChallenge_Once。
        // custom_action_param.times 由「挑战次数」选项覆写：1-99999，默认 1 次。
        // 每次挑战都会真实消耗体力。一次循环体没开始新战斗（多为体力不足已转「补充体力」）会重试，
        // 连续 3 次都没有新战斗开始（GameplayChallengeLoop 里的 MAX_STUCK_ATTEMPTS）才停止，不再继续消耗。
        // 副本结算页支持「挑战下一关」时，一次循环体会连着打多局快速再战，
        // 不再逐局退回副本详情页重选难度 / 助战 / 编队。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "GameplayChallengeLoop",
                "custom_action_param": {
                    "times": 1
                }
            }
        },
        "timeout": 3600000,
        "next": [
            "GameplayChallenge_Done"
        ]
    },
    "GameplayChallenge_Once": {
        // 一次挑战链路：定位副本详情页 → 开始挑战 → 助战选择 → 开始战斗 → 战斗模块 → 结算收尾。
        // 结算页有「挑战下一关」且后面还有次数时，BattleLoop 会直接点它再打一局（不再回到详情页）；
        // 打满次数 / 副本没有该按钮时，结算页点「确认」回到副本详情页，由 OnceDone 收尾。
        // 因此第二轮起由 AtDetail 接管，不走列表页。
        // 本次开始时若「补充体力」界面还开着（上一次补体力没走完 / 结算自动再战被体力拦住），
        // 先补体力再继续本次，不要空转结束。
        // next 首位挂公共异常处理：先兜掉遮屏弹窗 / 断线弹窗 / 体力弹窗，没有异常就立刻交回本列表。
        // ⚠️ 本节点是 DirectHit（没有 recognition）→ **识别永不失败 → 下面的 on_error 永远不会触发**。
        //    所以别指望"超时 → on_error → Exception_Unknown"这条路能兜住"当前页认不出来"。
        //    真正生效的兜底是 next 末位 Main 的 [JumpBack]GameplayChallenge_UnknownFallback：
        //    Main 的三个候选（列表卡片 / 滚动 / 开始挑战）全不命中时，才由它去关 X / 退一级 / 回主页。
        //    这里保留 on_error 只是形式上留一个入口（将来若给本节点加识别，它会自然生效），
        //    不要把它当成"卡死会自动回主页"的依据。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 45000,
        "next": [
            "[JumpBack]Exception_Start",
            "GameplayChallenge_OnceRefillGate",
            "GameplayChallenge_AtDetail",
            "[JumpBack]GameplayChallenge_OpenGameplay",
            "GameplayChallenge_Main"
        ],
        "on_error": [
            "Exception_Unknown"
        ]
    },
    "GameplayChallenge_OnceRefillGate": {
        // 每轮开头的补体力门控：体力不足时先把体力补满，补完回到本轮流程（AtDetail → 难度 → 开始挑战）。
        // 命中条件与 StaminaRefill_Dialog 保持一致；未命中（正常情况）本节点被跳过，Once 继续走 AtDetail。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    180,
                    120,
                    380,
                    100
                ],
                "expected": [
                    "补充体力"
                ],
                "threshold": 0.2
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "[JumpBack]StaminaRefill_Dialog",
            "GameplayChallenge_AtDetail"
        ]
    },
    "GameplayChallenge_AtDetail": {
        // 已在目标副本详情页（「开始挑战」可见）：直接重选配置难度继续挑战。
        // 必须先于列表流程判断，否则会在详情页误触发 SwipeList 的滚动。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    990,
                    340,
                    160
                ],
                "expected": [
                    "开始挑战"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 4000,
        "next": [
            "GameplayChallenge_Difficulty"
        ]
    },
    "GameplayChallenge_UnknownFallback": {
        // DirectHit 监督节点的「所有候选都不命中」出口（**有界保险丝**）。
        // 只允许挂在监督节点 next 的**末位**：它是无条件命中的，放前面会把后面所有候选吃掉。
        // 作用：遇到"当前页认不出来"（弹窗挡屏 / 卡在别的界面）时，把控制权交给异常链
        // （关 X → 退一级 → 回主页），跑完由 [JumpBack] 回到监督节点重新判定，实现同一次 run_task 内自愈。
        //
        // ⚠️ 为什么必须有 max_hit 这道保险丝（不能直接挂 [JumpBack]Exception_Unknown）：
        //    异常链里 Exception_BackToHub 的首个候选 Exception_AtHub 是"已回到主页"的判定，
        //    它在主页上会**直接命中且没有 next**，于是链结束 → [JumpBack] 回到监督节点 →
        //    监督节点仍然认不出主页（列表卡片 / 滚动 / 开始挑战都不在主页上）→ 又触发兜底 → 死循环。
        //    加上 max_hit 后：兜底跑满 6 次仍未恢复就停止命中，监督节点的 next 正常耗尽、
        //    本次 run_task 以失败结束，交回循环控制器按既有次数上限判断（不会无限循环）。
        "max_hit": 6,
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "Exception_Unknown"
        ]
    },
    "GameplayChallenge_Main": {
        // 玩法/终末之地列表页监督节点：先找目标副本卡片，找不到就向下滚动一屏再找。
        // 列表顺序：终末之地(头图) / 古代之塔 / 史莱姆宝库 / 火·元素试炼 / 风·元素试炼 / 水·元素试炼 / 土·元素试炼。
        // ⚠️ 末尾必须挂 OnceDone：DungeonEntry / SwipeList 都是 [JumpBack]，整条副本链路（直到结算收尾）
        // 走完后会跳回本节点的 next 继续识别，此时画面是副本详情页，两个列表候选都认不到；
        // 以前这里没有出口，会等满 4s 超时 → 「bad next」把本次挑战判成失败 → 循环控制器误判重打一次（白扣体力）。
        // OnceDone 认「开始挑战」（回详情页 = 本次挑战已结束），命中即正常收尾。
        //
        // ⚠️ 末尾还必须挂 [JumpBack]GameplayChallenge_UnknownFallback，兜「当前页认不出来」（弹窗挡屏 / 卡在别的页面）：
        //    本节点是 DirectHit（没有 recognition）→ **识别永不失败 → on_error 永远不会触发**，
        //    所以"超时交给 Exception_Unknown"这种写法对 DirectHit 监督节点是无效的。
        //    实机复现：游戏卡在「道具详情」弹窗（右上角有 X）时，上面三个候选全不命中 →
        //    next 耗尽 → bad next 直接判死本次挑战，异常链（关 X / 退一级 / 回主页）一次都没进，
        //    循环控制器连试 3 次都是 0/3。
        //    兜底节点是无条件命中的，只有前面全不命中才走得到；它跑完由 [JumpBack] 回到本节点重新判定，
        //    所以"关掉弹窗后页面恢复"能在同一次 run_task 内自愈，不用靠上层重试。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 4000,
        "next": [
            "[JumpBack]GameplayChallenge_DungeonEntry",
            "[JumpBack]GameplayChallenge_SwipeList",
            "GameplayChallenge_OnceDone",
            "[JumpBack]GameplayChallenge_UnknownFallback"
        ]
    },
    "GameplayChallenge_OpenGameplay": {
        // 主页底部导航「玩法」（720x1280 下按钮文字中心约 (423,1234)）。执行完由 [JumpBack] 回上层。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    330,
                    1195,
