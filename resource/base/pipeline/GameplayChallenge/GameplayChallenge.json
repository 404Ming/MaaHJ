    "GameplayChallenge_SwipeList": {
        "max_hit": 3,
        // 列表向下滚动一屏。expected 只认「列表页确实有副本卡片」时才滑，
        // 避免在副本详情页/战斗页等其它画面按 .* 盲滑（详情页 rewards 文案同样落在该 ROI 内）。
        "recognition": {
