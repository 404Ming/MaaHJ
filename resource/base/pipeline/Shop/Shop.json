        "action": {
            "type": "DoNothing"
        },
        "next": [
            "Shop_Gift_WeeklyBuy"
        ]
    },
    "Shop_Gift_WeeklyBuy": {
        // 每周礼包页：同一个礼包名在每周礼包里是另一个 SKU，所以单独跑一次勾选购买。
        "max_hit": 1,
