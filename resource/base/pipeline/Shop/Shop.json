    "Shop_BackHome": {
        // 回主页收尾（也是整条任务的最后一段）：先处理公共异常（奖励弹窗等），
        // 再认主页锚点；没到主页就点左下角返回退一级（商店页的返回是纯图标，OCR 读不到文字，
        // 只能用固定点；实测该点能退出商店回到主页）。
        // 刻意不用 Exception_BackToHub：它退不回主页时会落到 Exception_Restart 强杀重启游戏。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 8000,
        "next": [
            "[JumpBack]Exception_Start",
            "Shop_AtHub",
            "[JumpBack]Shop_Back"
        ]
    },
    "Shop_AtHub": {
        // 主页锚点：底部导航第一个按钮「惑星之间」（实测 OCR box (15,1236,98,30)）。
        // 命中即「已经回到主页」→ 交给 Shop_Done 正常收尾。
        "recognition": {
