        ]
    },
    "Shop_Back": {
        // 退一级：图片匹配左下角「返回」图标按钮（Daily/BackButton.png），命中后点其中心（居中点击返回）。
        // max_hit 限制退层级数，退不回主页就交给 Shop_BackHome 超时收尾，绝不无限点。
        // 本节点无 next，只作为 [JumpBack] 步骤供 Shop_BackHome 复用。
        "max_hit": 6,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    1180,
                    200,
                    100
                ],
                "template": [
                    "Daily/BackButton.png",
                    "Daily/BackButton2.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000
    },
    "Shop_Done": {
        // 收尾态（无 next → 整条任务链结束）：停在主页。
        "action": {
            "type": "DoNothing"
        }
    }
