{
    "LaunchGame_Start": {
        // 入口（用户需求）：**先判主页，不在主页就冷重启**。
        //   ① 在主页（OCR「惑星之间」或「每日任务」图标）→ 直接 Done：不杀进程、不 StartApp；
        //   ② 其它任何状态（登录页 / 更新弹窗 / 游戏内子页面 / 战斗中 / 桌面 / 后台）
        //      → LaunchGame_ColdRestart：StopApp → 等 5s → StartApp。
        // 启动之后的分流（更新弹窗、点击登录游戏、回到主页）由 LaunchGame_Launch 的 next 接手，
        // 所以这里只留两个候选：一个条件命中 + 一个无条件兜底，链是确定的。
        //
        // ⚠️ 语义变化：旧版会复用「已在游戏内」的运行实例（InGame → BackToMainHub_Start），
        //    新版**不再复用**——只要不在主页就杀进程。也就是说在子页面 / 战斗里调用「启动游戏」
        //    会中断当前进度，这是用户明确要求的行为，不是回归。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 25000,
        "next": [
            "LaunchGame_AtMainHub",
            "LaunchGame_ColdRestart"
        ]
    },
    "LaunchGame_AtMainHub": {
        // 主界面判定（唯一分流条件）：Or(「每日任务」图标模板, OCR「惑星之间」)。
        // 两个锚点都保留：图标会被横幅 / 活动浮层遮住，而底部「惑星之间」是主页独有的
        // ——实测 167 张流程截图审计（2026-10-23），该 ROI 只在主页命中，
        // 主城 / 子页面 / 战斗页同一位置显示的是「返回 / 世界」。
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "LaunchGame_MainHubDailyTask",
                    "LaunchGame_MainHubLoose"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 5000,
        "next": [
            "LaunchGame_Done"
        ]
    },
    "LaunchGame_MainHubDailyTask": {
        // 主页右侧「每日任务」图标模板（原 LaunchGame_AtMainHub 的判据，实测 ROI 585,550,135,125）。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    585,
                    550,
                    135,
                    125
                ],
                "template": "LaunchGame/MainHubDailyTask.png",
                "threshold": 0.7
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000
    },
    "LaunchGame_ColdRestart": {
        // 不在主页 → 杀进程 → 等 5s → 冷启动（用户需求）。
        // post_delay 5000：给系统回收进程、释放虚拟屏 producer 留缓冲。此前实测「对已在前台的游戏
        // 重复 StartApp」会拿到黑帧（详见 LaunchGame_Launch 的历史注释），先 StopApp 再等 5s 正好规避。
        // 注意这里**不能**复用 LaunchGame_StopApp：那个节点的 next 是 LaunchGame_Start，
        // 会把流程带回「判主页 → 又不在主页 → 再杀」，形成死循环。
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.Sextante.Micross"
            }
        },
        "post_delay": 5000,
        "next": [
            "LaunchGame_Launch"
        ]
    },
    "LaunchGame_MainHubLoose": {
        // 主页的**宽松**锚点（OCR「惑星之间」，与 BackToMainHub_AtMainHub 同 ROI/同文本）。
        // AtMainHub 用的是模板匹配「每日任务」图标，图标可能被横幅/弹窗半遮挡；
        // 这里补一个 OCR 锚点，避免把"已经在主页"误判成"不在游戏里"而重复 StartApp。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    1180,
                    170,
                    100
                ],
                "expected": ["惑星之间"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 4000
    },
    "LaunchGame_Login": {
        "max_hit": 6,
        // 登录界面：点击「点击登录游戏」，点完跳回父节点继续分流。
        // max_hit 限制重复点击；冷启动登录实测要点 2 次才生效（第一次点完仍短暂停在登录页），
        // 慢网络下可能需要更多次，3 → 6 留足余量；用尽后交回父节点按超时兜底（有界，不会死循环）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    270,
                    920,
                    210,
                    80
                ],
                "expected": ["点击登录游戏"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 3000
    },
    "LaunchGame_LoginUpdatePopup": {
        // 登录前的更新弹窗（用户需求）：点击「点击登录游戏」之前先判断有没有更新弹窗。
        // 判据用 OCR 而不是模板：弹窗文案/按钮会随版本变，图标位置也不固定。
        // ROI 收窄到弹窗主体（标题带 + 正文带，实测 720x1280：标题 y≈412~454、正文 y≈587~616）：
        // 只框住这两行文字，避免把加载页进度文字（「正在下载App配置文件」在 y≈1100）误判成弹窗。
        // expected 同时兜住标题与正文：标题「更新」，正文「获取配置文件异常，是否重新获取?」/
        // 「获取版本文件异常，是否重新获取?」两种文案（2026-10-21 实测出现「配置文件」变体）。
        // max_hit 3：一轮启动最多处理 3 次更新弹窗（有的版本会先弹公告再弹更新）。
        "max_hit": 3,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    80,
                    380,
                    560,
                    280
                ],
                "expected": [
                    "更新|重新获取|文件异常"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "LaunchGame_LoginUpdateConfirm"
        ]
    },
    "LaunchGame_LoginUpdateConfirm": {
        // 点更新弹窗上的「确认 / 确定」。
        // ROI 限在弹窗下半部的按钮带（y 700~930），避开正文里的「更新」和底部协议文字；
        // 实测 720x1280 按钮文字 box ≈ (275,845,166,52)，旧下界 900 只兜住上半行，
        // 下沿放到 930 才能整行进框（OCR 框被裁会掉字 → 认不到「确认」）。
        // 与既有的 LaunchGame_UpdateErrorConfirm 是同一套「窄 ROI + 点识别框中心」的做法。
        // max_hit 3：与上一个节点对齐，避免弹窗反复出现时无限点。
        "max_hit": 3,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    150,
                    700,
                    460,
                    230
                ],
                "expected": [
                    "确定|确认"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "next": [
            "LaunchGame_WaitLogin"
        ]
    },
    "LaunchGame_WaitLogin": {
        // 点完更新确认后持续等「点击登录游戏」：1 分钟（60000ms）内认不到就判定更新/下载卡住，
        // on_error → LaunchGame_LoginTimeout 重启游戏。60s 是用户给定的超时阈值。
        // 识别在 timeout 内会反复重试，等于每帧轮询登录按钮；认到就点（冷启动实测要点 2 次才生效，
        // 故 max_hit 8 留余量）。
        // next 显式回 LaunchGame_Start：点完登录后继续分流（主页 / 仍是登录页再点 / 进游戏），
        // 不依赖 [JumpBack] 的父链回跳语义，链路在这里是确定闭环。
        "max_hit": 8,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    270,
                    920,
                    210,
                    80
                ],
                "expected": [
                    "点击登录游戏"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 3000,
        "timeout": 60000,
        "next": [
            "LaunchGame_Start"
        ],
        "on_error": [
            "LaunchGame_LoginTimeout"
        ]
    },
    "LaunchGame_LoginTimeout": {
        // 1 分钟没等到登录界面：停进程 → 重跑启动流程（与热更新异常同一条兜底）。
        // max_hit 由用户要求取消：更新下载不定时长，允许一直重启到登录界面出来为止。
        // ⚠️ 这意味着「更新永远下不完」时会持续 停进程 → 重开 → 等 60s 循环，
        //    需要外部停止任务才能退出，排查卡死时先看这一层。
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.Sextante.Micross"
            }
        },
        "post_delay": 3000,
        "next": [
            "LaunchGame_Start"
        ]
    },
    "LaunchGame_Launch": {
        // 用游戏包名启动。timeout 是启动后等待出现主界面/登录界面的窗口。
        // 冷启动（异常重启路径）→ 登录 → 主页全链实测约 46s，慢网络下会超过 60s；
        // 60s 一到期就走 on_error → UpdateError（那是热更新弹窗专用），认不到就判失败、
        // 游戏被丢在登录页。放宽到 120s 留足冷启动余量。
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.Sextante.Micross"
            }
        },
        "post_delay": 3000,
        "timeout": 120000,
        "next": [
            "LaunchGame_AtMainHub",
            "[JumpBack]LaunchGame_LoginUpdatePopup",
            "[JumpBack]LaunchGame_Login"
        ],
        // 超时异常流程：启动后长时间既不是主界面也不是登录界面，多半是热更新异常弹窗。
        "on_error": [
            "LaunchGame_UpdateError"
        ]
    },
    "LaunchGame_UpdateError": {
        "max_hit": 2,
        // 热更新异常弹窗：标题「更新」，正文「获取版本文件异常，是否重新获取？」/
        // 「获取配置文件异常，是否重新获取?」两种文案都在线上出现过（2026-10-21 实测为「配置文件」，
        // 旧写法只认「版本文件」→ 认不到就把任务卡死在弹窗上）。
        // ROI 放到 (y 540~660) 兜住正文整行（实测 720x1280 正文 box ≈ (193,587,336,29)），
        // 下方按钮带不进来、上方标题也留出余量；expected 用分组同时命中两种文案。
        // max_hit 限制恢复次数，避免弹窗反复出现时无限循环。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    540,
                    520,
                    120
                ],
                "expected": ["(版本|配置)文件异常"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "LaunchGame_UpdateErrorConfirm"
        ]
    },
    "LaunchGame_UpdateErrorConfirm": {
        // 点击弹窗上的「确认」按钮（窄 ROI 限定在弹窗按钮带，避免误点其它界面的同名文字）。
        // 实测按钮文字 box ≈ (275,845,166,52)，旧 ROI 下沿 865 会把下半行切掉 → 下沿放到 910。
        // next 不再直接 StopApp：点确认后游戏开始下载/校验，**立刻停进程会让更新永远下不完**
        // （用户要求：点完确认继续检测登录按钮，1 分钟认不到才重启）。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    260,
                    790,
                    200,
                    120
                ],
                "expected": ["确认|确定"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "next": [
            "LaunchGame_WaitLogin"
        ]
    },
    "LaunchGame_StopApp": {
        // 结束游戏进程（公共节点，主要调用方是 ExceptionHandler 的 Exception_Restart）。
        // ⚠️ next 从 LaunchGame_Start 改成了 LaunchGame_Launch：
        //    现在 Start 的第一件事就是「不在主页 → ColdRestart → StopApp」，如果 StopApp 再回到 Start，
        //    就会「StopApp → 判主页(桌面) → 又 StopApp」白跑一轮 3s+5s。停完进程直接 StartApp 才是本意。
        // post_delay 5000：与 ColdRestart 一致的进程回收/虚拟屏 producer 释放缓冲。
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.Sextante.Micross"
            }
        },
        "post_delay": 5000,
        "next": [
            "LaunchGame_Launch"
        ]
    },
    "LaunchGame_Done": {
        // 完成态：游戏已停在主界面，可交给后续任务。
        "action": {
            "type": "DoNothing"
        }
    }
}
