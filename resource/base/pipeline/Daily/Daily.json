        ]
    },
    "Daily_AlreadyOnDailyPage": {
        // 「已经在每日任务列表页」判定：放在各个「前往」节点 next 的首位，命中即结束该任务分支、什么都不做，
        // 这样导航往返回来时不会在列表页上再点一次返回。
        // TODO: 副本内的自动完成（开始挑战 → 助战选择 → 编队 → 战斗回合 → 结算）尚未实现；
        // 当前「前往」只做导航并原路返回，见任务记录中的 EXPLORE 观察。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    420,
                    225,
                    240,
                    50
                ],
                "expected": [
                    "每天05:00刷新"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000
    },
    "Daily_BackToDailyPage": {
        "max_hit": 4,
        // 从「前往」落地的页面返回每日任务列表页（左下角图标返回按钮，与每日任务页是同一个控件）。
        // max_hit 4：返回层级有限，异常画面下也不会连点退到主页。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    1180,
                    200,
                    100
                ],
                "template": [
                    "Daily/BackButton.png",
                    "Daily/BackButton2.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 3000,
        "timeout": 2500
    }
}
