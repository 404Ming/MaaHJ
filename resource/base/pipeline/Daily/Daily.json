{
    "Daily_Start": {
        // 入口：不在每日任务页则先打开它，然后在页内主循环里处理。
        // next 只放条件节点：无条件 DirectHit 节点会让后面的候选永远不被识别。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 20000,
        // 候选顺序：主页「每日任务」→（认不到时）主页「菜单」→ 菜单页「日常」→ 页内主循环。
        // 兜底两条是用户新增需求：有些情况下主页右侧功能列里看不到「每日任务」，
        // 走「菜单 → 日常」同样能进每日任务页（实机验证：菜单页「日常」格点进去就是本页，页签停在「日常」）。
        "next": [
            "[JumpBack]Daily_OpenPage",
            "[JumpBack]Daily_OpenMenu",
            "[JumpBack]Daily_EnterFromMenu",
            "Daily_Main"
        ]
    },
    "Daily_OpenPage": {
        // 主页右侧功能列里的「每日任务」入口。执行完由 [JumpBack] 回 Start。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    380,
                    160,
                    700
                ],
                "expected": [
                    "每日任务"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2500
    },
    "Daily_OpenMenu": {
        // 兜底入口第一跳：主页底部导航最右侧「菜单」（实测 OCR box (636,1228,57,36)）。
        // 只有主页认不到「每日任务」时才会走到这里（候选顺序在其后）。
        // max_hit 1：导航是一次性动作，回到主页后监督节点重新判定时不会又跑一遍。
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    580,
                    1195,
                    140,
                    85
                ],
                "expected": [
                    "菜单"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "timeout": 3000,
        "next": [
            "Daily_Start"
        ]
    },
    "Daily_EnterFromMenu": {
        // 兜底入口第二跳：菜单页功能格里的「日常」（实测 OCR box (195,977,52,32)）。
        // 点它直接落到每日任务页（页签停在「日常」），后面的主循环照常跑。
        // ⚠️ ROI 只框菜单页那一格（y 930~1015）：每日任务页底部也有「日常」页签
        //    （实测 box (173,1106,59,38)），框宽了会在本页把自己再点一遍、还会让
        //    [JumpBack] 反复命中空转。
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    160,
                    930,
                    140,
                    85
                ],
                "expected": [
                    "日常"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1200,
        "timeout": 3000,
        "next": [
            "Daily_Start"
        ]
    },
    "Daily_Main": {
        // 页内主循环：①先领完可领奖励 ②两个挑战都尝试过且奖杯≥30 则领里程碑奖励并回主页收尾
        // ③否则按优先级去完成任务（史莱姆宝库 → 火元素试炼 → 创建房间）。
        // 每一轮从列表头部重新判定（领取后列表会重排，可领取的行会浮到最上）。
        // next 首位挂公共异常处理：遮屏弹窗 / 断线弹窗 / 体力弹窗先兜掉，没有异常立刻交回本列表。
        // 注意本节点 timeout=3000 太短，不能当「卡死」窗口，故这里不挂 on_error → Exception_Unknown。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "[JumpBack]Exception_Start",
            "[JumpBack]Daily_ClaimRewards",
            "Daily_TrophyGate",
            "[JumpBack]Daily_PickTask"
        ]
    },
    "Daily_TrophyGate": {
        // 奖杯结算闸门：必须等「火元素试炼」挑战节点命中过，才允许进入 Daily_TrophyEnough。
        // 否则史莱姆宝库打完、领完 15 奖杯后如果已经 >= 30，会直接把元素试炼跳过。
        // 火元素试炼任务本身已完成/不存在时，由 Daily_NoMoreTask 的兜底分支做最后一次奖杯判定。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyTrophyGate"
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": [
            "Daily_TrophyEnough",
            "Daily_PickTask"
        ]
    },
    "Daily_ClaimRewards": {
        "max_hit": 12,
        // 领取任务奖励：完成后按钮由「前往」变为「领取」，领取后行置灰为「已完成」。
        // order_by + index 取最上面那条「领取」；max_hit 限制单次运行的领取次数。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    60,
                    440,
                    660,
                    640
                ],
                "expected": [
                    "领取"
                ],
                "order_by": "Vertical",
                "index": 0
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000
    },
    "Daily_TrophyEnough": {
        // 奖杯判定：顶部奖杯数字 ≥ 30 时命中（30-99 或 100+，用正则表达「大于等于」）。
        // 25 / 29 这类两位数不会命中；命中后走「领里程碑 → 回主页」收尾分支。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    400,
                    90,
                    55
                ],
                "expected": [
                    "[3-9][0-9]|\\d{3,}"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": [
            "Daily_ClaimMilestone",
            "Daily_BackToHub"
        ]
    },
    "Daily_ClaimMilestone": {
        // 领取 30 奖杯里程碑宝箱（紫水晶 x100）。
        // 用「未领取」状态的图标做模板匹配：已达到且未领取时该位置是紫水晶图标，领取后变成对勾。
        // （不能用 OCR「100」判断：领取后角标 100 仍在，会误判为未领取。）
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    540,
                    320,
                    140,
                    120
                ],
                "template": "Daily/Milestone30Reward.png",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000,
        "next": [
            "Daily_CloseRewardPopup",
            "Daily_BackToHub"
        ]
    },
    "Daily_CloseRewardPopup": {
        // 「恭喜获得」弹窗：点提示文字所在的空白区域关闭。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    240,
                    925,
                    250,
                    60
                ],
                "expected": [
                    "点击空白区域关闭"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000,
        "next": [
            "Daily_BackToHub"
        ]
    },
    "Daily_BackToHub": {
        "max_hit": 1,
        // 每日任务页左下角返回按钮（图标按钮，无文字）：点它回到主页（惑星之间）。
        // 模板取自实拍截图裁剪：BackButton.png 是白色双箭头样式；
        // BackButton2.png 是徽章式返回键（古代之塔等页面）中央的金色箭羽纹。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    1180,
                    200,
                    100
                ],
                "template": [
                    "Daily/BackButton.png",
                    "Daily/BackButton2.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2500,
        "next": [
            "Daily_Done"
        ]
    },
    "Daily_Done": {
        // 完成态：奖杯已达标并领到里程碑奖励，游戏停在主页，可交给后续任务。
        // ⚠️ 收尾必须显式 StopTask，不能留空 next：本链是从 Daily_Start 的 [JumpBack]Daily_OpenPage
        //    走下来的，空 next 只会把控制权退回 Daily_Start 的候选列表重新判定；此时人已经在主页，
        //    「每日任务」入口再次命中 ⇒ 又拉起 Daily_Main → Daily_TrophyGate → Daily_TrophyEnough。
        //    第二轮里里程碑已领（模板不命中）、Daily_BackToHub 的 max_hit=1 也已用尽，
        //    于是 Node.NextList.Failed ⇒ 整条日常任务判 FAILED（流程其实早已完成）。
        //    实测 2026-10-28 05:27:21：两个副本都打完、里程碑也领到手，仍报「任务失败：日常任务」。
        //    与 Weekly_Finish / MachineGodDescent_StopTask 的收尾写法保持一致。
        "action": {
            "type": "StopTask"
        }
    },
    "Daily_PickTask": {
        // 任务优先级（用户指定，与游戏列表顺序一致）：
        // 完成1次史莱姆宝库 > 完成1次任意元素试炼副本 > 创建一次房间。
        // 「累积消耗体力」按用户要求不再识别。
        // 直接挂各任务的「前往」节点：DailyTaskRowGo 会同时校验标题和同行「前往」，
        // 已完成（按钮变成「领取/已完成」）或不在列表里的任务会自然失败并跳到下一个候选。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 3000,
        "next": [
            "Daily_Go_Slime",
            "Daily_Go_ElementTrial",
            "Daily_Go_CreateRoom",
            "Daily_NoMoreTask"
        ]
    },
    "Daily_NoMoreTask": {
        // 所有已知任务都尝试过（或列表中已不存在）时的兜底：
        // 先做最后一次奖杯判定（元素试炼任务已完成/不存在时 Fire 挑战节点不会命中，
        // Daily_TrophyGate 永远不会放行，所以这里必须绕过闸门直接判定）。
        // 奖杯不足 30 时由 Daily_Stop 正常结束任务。
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "Daily_TrophyEnough",
            "Daily_Stop"
        ]
    },
    "Daily_Stop": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopTask"
        }
    },
    "Daily_Go_Slime": {
        "max_hit": 1,
        // 任务列表会重排，不能固定取第几个「前往」。
        // 通过 DailyTaskRowGo 自定义识别：先找该任务标题所在行，再点同行右侧的「前往」。
        // 点完「前往」满足日常任务的导航要求后，先回主页，再由 Daily_Challenge_Slime 调用「玩法挑战」真正打一次。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyTaskRowGo",
                "custom_recognition_param": {
                    "title": ".*史莱姆宝库.*"
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000,
        "next": [
            "Daily_ReturnHome_Slime"
        ]
    },
    "Daily_ReturnHome_Slime": {
        // 点完「前往」后回主页。用 CustomAction 包一次 BackToMainHub_Start：
        // 不能写成 [JumpBack]BackToMainHub_Start + 下一个候选，BackToMainHub_Start 在主页上永远命中，
        // [JumpBack] 回到父节点后会从 next 头部重试 → 死循环。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DailyReturnHome"
            }
        },
        "timeout": 60000,
        "next": [
            "Daily_Challenge_Slime"
        ]
    },
    "Daily_Go_ElementTrial": {
        "max_hit": 1,
        // 点完「前往」后回主页，由 Daily_Challenge_Fire 调用「玩法挑战」打一次火元素试炼。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyTaskRowGo",
                "custom_recognition_param": {
                    "title": ".*元素试炼.*"
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000,
        "next": [
            "Daily_ReturnHome_Fire"
        ]
    },
    "Daily_ReturnHome_Fire": {
        // 同 Daily_ReturnHome_Slime：回主页后再调用玩法挑战打火元素试炼。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DailyReturnHome"
            }
        },
        "timeout": 60000,
        "next": [
            "Daily_Challenge_Fire"
        ]
    },
    "Daily_Challenge_Slime": {
        // 从主页调用「玩法挑战」打 1 次史莱姆宝库（默认难度 = 深渊），玩法挑战收尾会自动回主页。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DailyChallengeGameplay",
                "custom_action_param": {
                    "dungeon": "史莱姆宝库",
                    "difficulty": "深渊",
                    "times": 1
                }
            }
        },
        "timeout": 3600000,
        "next": [
            "Daily_ResumeAfterChallenge"
        ]
    },
    "Daily_Challenge_Fire": {
        // 从主页调用「玩法挑战」打 1 次火元素试炼（默认难度 = 深渊），玩法挑战收尾会自动回主页。
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DailyChallengeGameplay",
                "custom_action_param": {
                    "dungeon": "火·元素试炼",
                    "difficulty": "深渊",
                    "times": 1
                }
            }
        },
        "timeout": 3600000,
        "next": [
            "Daily_ResumeAfterChallenge"
        ]
    },
    "Daily_ResumeAfterChallenge": {
        // 玩法挑战结束后已回到主页：重新打开每日任务页，让外层 Daily_Main 继续领奖 / 判定奖杯。
        // 已在每日任务页时 Daily_OpenPage 不命中，由 Daily_Unwind 兜底结束本节点。
        // 这里不能用 [JumpBack]Daily_OpenPage：next 列表只有它一个候选时，JumpBack 回到本节点会
        // 反复重试同一个已失败节点直到 timeout（实机日志里连续 20+ 次 Daily_OpenPage 失败）。
        "action": {
            "type": "DoNothing"
        },
        "timeout": 20000,
        "next": [
            "Daily_OpenPage",
            "Daily_Unwind"
        ]
    },
    "Daily_Unwind": {
        // 无条件终点：Daily_ResumeAfterChallenge 里 Daily_OpenPage 没命中时走这里，
        // 保证节点正常结束并把控制权交回外层 Daily_Main，而不是以识别失败收场。
        "action": {
            "type": "DoNothing"
        }
    },
    "Daily_Go_CreateRoom": {
        "max_hit": 1,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyTaskRowGo",
                "custom_recognition_param": {
                    "title": ".*创建.*房间.*"
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2000,
        "next": [
            "Daily_AlreadyOnDailyPage",
            "Daily_BackToDailyPage"
        ]
    },
    "Daily_AlreadyOnDailyPage": {
        // 「已经在每日任务列表页」判定：创建房间的「前往」只做导航，命中即结束该分支、什么都不做，
        // 这样导航往返回来时不会在列表页上再点一次返回。
        // 史莱姆宝库 / 火元素试炼已改为「前往 → 回主页 → 玩法挑战 → 回每日任务页」，不再使用本节点。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    420,
                    225,
                    240,
                    50
                ],
                "expected": [
                    "每天05:00刷新"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000
    },
    "Daily_BackToDailyPage": {
        "max_hit": 4,
        // 从「前往」落地的页面返回每日任务列表页（左下角图标返回按钮，与每日任务页是同一个控件）。
        // max_hit 4：返回层级有限，异常画面下也不会连点退到主页。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    1180,
                    200,
                    100
                ],
                "template": [
                    "Daily/BackButton.png",
                    "Daily/BackButton2.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "timeout": 2500
    }
}
