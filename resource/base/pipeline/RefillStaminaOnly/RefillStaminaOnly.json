            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "[JumpBack]EnergyRefill_Dialog",
            "[JumpBack]StaminaRefill_Dialog",
            "RefillStaminaOnly_Start"
        ]
